# Copy to .env.local and fill in.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/lekhak
MONGODB_DB=lekhak
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_LIVE_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
GEMINI_EMBED_MODEL=gemini-embedding-2
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-string
# Public origin used inside QR codes (so phones open the real deployment, not a local alias)
NEXT_PUBLIC_APP_URL=https://lekhak-piramal.vercel.app
NEXT_PUBLIC_EVENT_NAME=Piramal Finance Investor Day 2026
